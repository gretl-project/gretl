#: plugin/vif.c:463
msgid "smallest is"
msgstr "najmniejszy jest"

#: plugin/vif.c:520
msgid "Variance Inflation Factors"
msgstr "Ocena współliniowości VIF(j) - czynnik rozdęcia wariancji"

