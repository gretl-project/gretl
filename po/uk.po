#, c-format
msgid ""
"Hausman test statistic:\n"
" H = %g with p-value = prob(chi-square(%d) > %g) = %g\n"
msgstr ""
"Статистика тесту Гаусмана (Hausman):\n"
" H = %g, p-значення = prob(хі-квадрат(%d) > %g) = %g\n"

