set verbose off
include kmeans.gfn

open iris.gdt
list L = 1 .. 4
matrix X = {L}
bundle b = kmeans(X, 3, _(init="hw", verbosity=2))
series sphat = b.cluster_id
kmeans_crosstab(sphat, species)

# experiment using species as initial clusters
printf "\n"
matrix C0 = meanc(X[1:50,]) | meanc(X[51:100,]) | meanc(X[101:150,])
print C0
bundle b = kmeans(X, C0, _(verbosity=2, init="pc"))
