set verbose off
clear
set assert stop

function void test_atan2_broadcast (void)
    print "Start testing atan2() broadcasting a 1-element matrix"

    # Bad input: if a and b are both vectors, they must be of
	# the same length per the documentation
    matrix a = {1}
    matrix b = {1, 2, 3, 4, 5}

    # When
    catch matrix y = atan2(a, b)

    # Then
    assert($error != 0)
end function
test_atan2_broadcast()

print "Successfully finished tests."
quit
