set verbose off
clear
set assert stop

# Regression test: allocating a matrix whose total element count
# (rows * cols) overflows a 32-bit signed int, meaning that the
# resulting matrix -- even if it could be allocated -- cannot be
# fully indexed.
# Date: September 2026

function void test_large_matrix_alloc (void)
    print "Start testing too big matrix allocation (rows*cols overflow)"

    # Given
    scalar n = 65536

    # When
    catch matrix M = zeros(n, n)

    # Then
    assert($error != 0)
end function
test_large_matrix_alloc()

print "Successfully finished tests."
quit
